#!/bin/bash

# Скрипт инициализации для seeed-voicecard
# Адаптирован для Orange Pi Zero 2W с 4-микрофонным массивом

# Определение типа звуковой карты
sound_card_id=$(aplay -l | grep -i seeed | head -n 1 | awk -F': ' '{print $1}' | awk '{print $2}')
sound_card_name=$(aplay -l | grep -i seeed | head -n 1 | awk -F': ' '{print $2}' | awk -F',' '{print $1}')

echo "Инициализация ReSpeaker для Orange Pi Zero 2W..."
echo "Обнаружена звуковая карта: $sound_card_name (id: $sound_card_id)"

# Проверка наличия файлов состояний
if [ -f /etc/voicecard/ac108_asound.state ]; then
    # Для 4-микрофонной карты
    if [[ "$sound_card_name" == *"4mic"* ]] || [[ "$sound_card_name" == *"seeed-4"* ]]; then
        echo "Загрузка настроек для 4-микрофонного массива..."
        alsactl restore -f /etc/voicecard/ac108_asound.state
        
        # Дополнительные настройки микшера для AC108
        if command -v amixer > /dev/null; then
            echo "Настройка микшера для AC108..."
            # Установка уровней усиления для всех микрофонов
            amixer -c $sound_card_id set 'ADC PGA gain' 31 > /dev/null
            amixer -c $sound_card_id set 'ADC volume' 180 > /dev/null
            # Настройка маршрутизации
            amixer -c $sound_card_id set 'MIC1 boost gain' 0 > /dev/null
            amixer -c $sound_card_id set 'MIC2 boost gain' 0 > /dev/null
            amixer -c $sound_card_id set 'MIC3 boost gain' 0 > /dev/null
            amixer -c $sound_card_id set 'MIC4 boost gain' 0 > /dev/null
        fi
    fi
elif [ -f /etc/voicecard/wm8960_asound.state ]; then
    # Для 2-микрофонной карты (WM8960)
    echo "Загрузка настроек для 2-микрофонной карты..."
    alsactl restore -f /etc/voicecard/wm8960_asound.state
else
    echo "ПРЕДУПРЕЖДЕНИЕ: Файлы состояния ALSA не найдены в /etc/voicecard/"
    exit 1
fi

# Проверка, что карта успешно инициализирована
if arecord -l | grep -q "seeed"; then
    echo "ReSpeaker успешно инициализирован на Orange Pi Zero 2W"
else
    echo "ОШИБКА: Не удалось инициализировать устройство записи ReSpeaker"
    exit 1
fi

# Создание конфигурации ALSA для удобного доступа к устройству
if [ ! -f /etc/asound.conf ]; then
    echo "Создание конфигурации ALSA для удобства использования..."
    cat > /etc/asound.conf << EOF
pcm.mic_array {
    type plug
    slave {
        pcm "hw:$sound_card_id,0"
        channels 4
        rate 48000
        format S16_LE
    }
}

pcm.playback {
    type plug
    slave {
        pcm "hw:$sound_card_id,0"
        channels 2
        rate 48000
        format S16_LE
    }
}

pcm.!default {
    type asym
    playback.pcm "playback"
    capture.pcm "mic_array"
}
EOF
fi

exit 0
